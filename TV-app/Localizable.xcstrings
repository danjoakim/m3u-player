        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt categorieën zoals XXX, Adult en 18+ overal in de app. Uitschakelen vereist Face ID, Touch ID of je toegangscode."
          }
        },
        "pl" : {
