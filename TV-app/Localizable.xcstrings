          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa luokat, kuten XXX, Adult ja 18+, kaikkialla apissa. Poistaminen käytöstä vaatii Face ID:n, Touch ID:n tai pääsykoodin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les catégories comme XXX, Adult et 18+ partout dans l’app. La désactivation nécessite Face ID, Touch ID ou votre code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde categorie come XXX, Adult e 18+ in tutta l’app. Per disattivarlo servono Face ID, Touch ID o il codice."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler kategorier som XXX, Adult og 18+ overalt i appen. For å slå det av kreves Face ID, Touch ID eller kode."
          }
