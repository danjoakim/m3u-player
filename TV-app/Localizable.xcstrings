    "The app doesn't include any content. Only use playlists you have the right to watch." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen indeholder intet indhold. Brug kun lister, du har ret til at se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App enthält keine Inhalte. Verwende nur Playlists, die du ansehen darfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no incluye contenido. Usa solo listas que tengas derecho a ver."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
