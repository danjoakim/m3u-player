    "XMLTV link from your provider, .xml or .xml.gz. Filled in automatically if the playlist includes one. The guide updates every 12 hours." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV-link fra din udbyder, .xml eller .xml.gz. Udfyldes automatisk, hvis listen angiver et. Guiden opdateres hver 12. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV-Link deines Anbieters, .xml oder .xml.gz. Wird automatisch ausgefüllt, wenn die Playlist einen enthält. Das Programm wird alle 12 Stunden aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlace XMLTV de tu proveedor, .xml o .xml.gz. Se rellena automáticamente si la lista incluye uno. La guía se actualiza cada 12 horas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palveluntarjoajan XMLTV-linkki, .xml tai .xml.gz. Täytetään automaattisesti, jos soittolistassa on sellainen. Opas päivittyy 12 tunnin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lien XMLTV de votre fournisseur, .xml ou .xml.gz. Rempli automatiquement si la playlist en contient un. Le guide est mis à jour toutes les 12 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link XMLTV del tuo provider, .xml o .xml.gz. Compilato automaticamente se la playlist ne include uno. La guida si aggiorna ogni 12 ore."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV-lenke fra leverandøren, .xml eller .xml.gz. Fylles ut automatisk hvis listen oppgir en. Guiden oppdateres hver 12. time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV-link van je provider, .xml of .xml.gz. Wordt automatisch ingevuld als de afspeellijst er een bevat. De gids wordt elke 12 uur bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link XMLTV od dostawcy, .xml lub .xml.gz. Wypełniany automatycznie, jeśli playlista go zawiera. Przewodnik aktualizuje się co 12 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link XMLTV do seu provedor, .xml ou .xml.gz. Preenchido automaticamente se a playlist incluir um. O guia é atualizado a cada 12 horas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV-länk från din leverantör, .xml eller .xml.gz. Fylls i automatiskt om listan anger en. Guiden uppdateras var 12:e timme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务商提供的 XMLTV 链接（.xml 或 .xml.gz）。如果播放列表中包含该链接，会自动填写。指南每 12 小时更新一次。"
          }
        }
      }
    },
    "Xtream accounts get their TV guide automatically. Enter a link here only to use a different guide." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-konti får tv-guiden automatisk. Angiv kun et link her, hvis du vil bruge en anden guide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-Konten erhalten das TV-Programm automatisch. Gib hier nur einen Link ein, wenn du ein anderes Programm verwenden möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas Xtream obtienen la guía de TV automáticamente. Introduce un enlace aquí solo si quieres usar otra guía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-tilit saavat TV-oppaan automaattisesti. Lisää linkki tähän vain, jos haluat käyttää toista opasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes Xtream reçoivent leur guide TV automatiquement. Saisissez un lien ici uniquement pour utiliser un autre guide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account Xtream ricevono la guida TV automaticamente. Inserisci un link qui solo per usare una guida diversa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-kontoer får TV-guiden automatisk. Legg bare inn en lenke her hvis du vil bruke en annen guide."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-accounts krijgen de tv-gids automatisch. Voer hier alleen een link in als je een andere gids wilt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konta Xtream otrzymują przewodnik TV automatycznie. Wpisz tu link tylko wtedy, gdy chcesz użyć innego przewodnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas Xtream recebem o guia de TV automaticamente. Insira um link aqui apenas para usar outro guia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream-konton får tv-guiden automatiskt. Ange bara en länk här om du vill använda en annan guide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtream 账户会自动获取电视指南。只有想使用其他指南时才需要在此输入链接。"
          }
        }
      }
    },
