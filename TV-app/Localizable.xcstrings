    "Hides categories such as XXX, Adult and 18+ everywhere in the app. Turning it off requires Face ID, Touch ID or your passcode." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler kategorier som XXX, Adult og 18+ overalt i appen. For at slå det fra kræves Face ID, Touch ID eller kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet Kategorien wie XXX, Adult und 18+ überall in der App aus. Zum Ausschalten sind Face ID, Touch ID oder dein Code nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
