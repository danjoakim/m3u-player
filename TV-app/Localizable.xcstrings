    "Drag to reorder categories. Hidden categories aren't shown in channel lists." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at ændre rækkefølgen. Skjulte kategorier vises ikke i kanallisterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um die Reihenfolge zu ändern. Ausgeblendete Kategorien erscheinen nicht in den Senderlisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Las categorías ocultas no aparecen en las listas de canales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta järjestystä vetämällä. Piilotettuja luokkia ei näytetä kanavaluetteloissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Les catégories masquées n’apparaissent pas dans les listes de chaînes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Le categorie nascoste non compaiono negli elenchi dei canali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å endre rekkefølgen. Skjulte kategorier vises ikke i kanallistene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om de volgorde te wijzigen. Verborgen categorieën worden niet in zenderlijsten getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Ukryte kategorie nie są widoczne na listach kanałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Categorias ocultas não aparecem nas listas de canais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra ordningen. Dolda kategorier visas inte i kanallistorna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以调整类别顺序。隐藏的类别不会显示在频道列表中。"
          }
        }
      }
    },
    "Enter the server address, username and password from your provider. The password is stored securely in the keychain." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast serveradresse, brugernavn og adgangskode fra din udbyder. Adgangskoden gemmes sikkert i nøgleringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Serveradresse, Benutzername und Passwort deines Anbieters ein. Das Passwort wird sicher im Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la dirección del servidor, el nombre de usuario y la contraseña de tu proveedor. La contraseña se guarda de forma segura en el llavero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna palveluntarjoajasi palvelimen osoite, käyttäjätunnus ja salasana. Salasana tallennetaan turvallisesti avainnippuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’adresse du serveur, le nom d’utilisateur et le mot de passe de votre fournisseur. Le mot de passe est stocké en toute sécurité dans le trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci indirizzo del server, nome utente e password del tuo provider. La password viene salvata in modo sicuro nel portachiavi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn serveradresse, brukernavn og passord fra leverandøren din. Passordet lagres trygt i nøkkelringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer het serveradres, de gebruikersnaam en het wachtwoord van je provider in. Het wachtwoord wordt veilig in de sleutelhanger bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz adres serwera, nazwę użytkownika i hasło od dostawcy. Hasło jest bezpiecznie przechowywane w pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o endereço do servidor, o nome de usuário e a senha do seu provedor. A senha é armazenada com segurança nas Chaves."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange serveradress, användarnamn och lösenord från din leverantör. Lösenordet sparas säkert i nyckelringen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入服务商提供的服务器地址、用户名和密码。密码会安全地存储在钥匙串中。"
          }
        }
      }
    },
