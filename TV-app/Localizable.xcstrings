    "Add a TV guide (EPG) in Settings to see today's sports broadcasts." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en tv-guide (EPG) under Indstillinger for at se dagens sportsudsendelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in den Einstellungen ein TV-Programm (EPG) hinzu, um die heutigen Sportübertragungen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una guía de TV (EPG) en Ajustes para ver las retransmisiones deportivas de hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää TV-opas (EPG) asetuksissa nähdäksesi päivän urheilulähetykset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un guide TV (EPG) dans les réglages pour voir les retransmissions sportives du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una guida TV (EPG) nelle impostazioni per vedere le trasmissioni sportive di oggi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn en TV-guide (EPG) under Innstillinger for å se dagens sportssendinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg in Instellingen een tv-gids (EPG) toe om de sportuitzendingen van vandaag te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj przewodnik TV (EPG) w Ustawieniach, aby zobaczyć dzisiejsze transmisje sportowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um guia de TV (EPG) nos Ajustes para ver as transmissões esportivas de hoje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en tv-guide (EPG) i Inställningar för att se dagens sportsändningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中添加电视指南（EPG）即可查看今天的体育直播。"
          }
        }
      }
    },
    "Add a TV guide (EPG) in Settings to see what's on." : {
      "localizations" : {
